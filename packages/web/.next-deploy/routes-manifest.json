    },
    {
      "page": "/admin/servicos",
      "regex": "^/admin/servicos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/servicos(?:/)?$"
    },
    {
      "page": "/admin/zernio",
      "regex": "^/admin/zernio(?:/)?$",
