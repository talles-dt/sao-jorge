# ☩ São Jorge n8n — Environment Variables
# Set ALL of these in Railway Dashboard → Variables
# Never commit real values

# ── n8n Core ──────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_STRONG_PASSWORD
N8N_ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_-hex_32

# ── Database (Railway Postgres addon — auto-filled by Railway) ────────────────
PGHOST=
PGPORT=5432
PGDATABASE=railway
PGUSER=postgres
PGPASSWORD=

# ── Workers backend (São Jorge) ───────────────────────────────────────────────
WORKER_URL=https://sao-jorge-curitiba.YOUR_ACCOUNT.workers.dev
WORKER_ADMIN_TOKEN=YOUR_ADMIN_TOKEN_HERE

# ── Instagram Graph API ───────────────────────────────────────────────────────
IG_ACCESS_TOKEN=YOUR_LONG_LIVED_TOKEN
IG_BUSINESS_ACCOUNT_ID=YOUR_IG_BUSINESS_ID
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET

# ── YouTube / Google ──────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID

# ── Webhook security ──────────────────────────────────────────────────────────
# Random string — Workers sends this header to verify webhook calls are legit
N8N_WEBHOOK_SECRET=GENERATE_WITH_openssl_rand_-hex_24
